# Antigravity Bridge — example configuration
# Copy to .env and fill in your values. server.py loads .env by itself
# (no python-dotenv, no `export` needed).

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=52847

# ── Debug ──────────────────────────────────────────────────────
# 1 = tracebacks completos en errores + log de cada request upstream (body recortado)
BRIDGE_DEBUG=0

# ── OAuth client (público) ─────────────────────────────────────
# Client OAuth de Antigravity (mismo que agy y opencode-antigravity-auth).
# Son valores publicos (desktop OAuth con PKCE) pero GitHub los bloquea en commits,
# por eso NO vienen en server.py: OBLIGATORIO ponerlos aqui. Se sacan del plugin:
#   npm pack opencode-antigravity-auth && tar xzf opencode-antigravity-auth-*.tgz
#   grep -rho 'CLIENT_[A-Z]* = "[^"]*' package/
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# ── Refresh token (single-account) ─────────────────────────────
# Obtenlo con: python3 auth-login.py  (o POST /auth/login)
# IMPORTANTE (sep 2026): el backend exige el scope https://www.googleapis.com/auth/aicode.
# Un refresh_token generado con la versión anterior del bridge NO lo tiene -> 401.
# Vuelve a hacer login después de actualizar.
BRIDGE_REFRESH_TOKEN=

# ── Fingerprint del Antigravity CLI (capturado con mitmproxy) ──
# Endpoint del backend. El IDE viejo usaba cloudcode-pa; el CLI usa daily-cloudcode-pa.
# ANTIGRAVITY_ASSIST_URL=https://daily-cloudcode-pa.googleapis.com/v1internal
# User-Agent: antigravity/cli/<AGY_CLI_VERSION> (aidev_client; os_type=linux; arch=amd64; cl=<AGY_CLI_CL>; auth_method=<AGY_AUTH_METHOD>)
# AGY_CLI_VERSION=1.1.28
# AGY_CLI_CL=978129418
# AGY_AUTH_METHOD=consumer        # consumer = cuenta Google AI Pro/Ultra
# Project que manda el CLI con auth consumer (fallback si loadCodeAssist no devuelve uno)
# AGY_CONSUMER_PROJECT=aicode-consumers

# ── Client authentication (single-account mode) ────────────────
# Require clients to send: Authorization: Bearer <key>
# BRIDGE_API_KEY=sk-your-random-key

# ── Admin protection ──────────────────────────────────────────
# Protects /admin/* endpoints. If empty → open access (dev mode).
# BRIDGE_ADMIN_KEY=sk-admin-secret

# ── Multi-account ─────────────────────────────────────────────
# BRIDGE_ACCOUNTS_FILE=./accounts.json
# BRIDGE_AUTH_CACHE_DIR=./auth_cache
