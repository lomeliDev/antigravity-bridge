# Antigravity Bridge — example configuration
# Copy to .env and fill in your values. server.py loads .env by itself
# (no python-dotenv, no `export` needed).

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=52847

# ── Debug ──────────────────────────────────────────────────────
# 1 = full tracebacks on errors + log of every upstream request (body truncated; includes base64 images)
BRIDGE_DEBUG=0

# ── OAuth client (REQUIRED) ────────────────────────────────────
# Antigravity's OAuth client (same one agy and opencode-antigravity-auth use).
# Public values (desktop OAuth with PKCE) but GitHub blocks commits containing them,
# so they are NOT in server.py. Get them from the npm package:
#   npm pack opencode-antigravity-auth && tar xzf opencode-antigravity-auth-*.tgz
#   grep -rho 'CLIENT_[A-Z]* = "[^"]*' package/
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# ── Refresh token (single-account) ─────────────────────────────
# Get it with: python3 auth-login.py   (standalone, no server needed)
# IMPORTANT (Sep 2026): the backend requires the scope https://www.googleapis.com/auth/aicode.
# A refresh_token created with the old bridge does NOT have it -> 401. Re-login after updating.
BRIDGE_REFRESH_TOKEN=

# ── Antigravity CLI fingerprint (captured with mitmproxy) ──────
# Backend endpoint. The old IDE used cloudcode-pa; the CLI uses daily-cloudcode-pa.
# ANTIGRAVITY_ASSIST_URL=https://daily-cloudcode-pa.googleapis.com/v1internal
# User-Agent: antigravity/cli/<AGY_CLI_VERSION> (aidev_client; os_type=linux; arch=amd64; cl=<AGY_CLI_CL>; auth_method=<AGY_AUTH_METHOD>)
# AGY_CLI_VERSION=1.1.28
# AGY_CLI_CL=978129418
# AGY_AUTH_METHOD=consumer        # consumer = Google AI Pro/Ultra account
# Project sent by the CLI with consumer auth (fallback when loadCodeAssist returns none)
# AGY_CONSUMER_PROJECT=aicode-consumers

# ── Client authentication (single-account mode) ────────────────
# Require clients to send: Authorization: Bearer <key>
# BRIDGE_API_KEY=sk-your-random-key

# ── Admin protection ──────────────────────────────────────────
# Protects /admin/* endpoints. If empty → open access (dev mode).
# BRIDGE_ADMIN_KEY=sk-admin-secret

# ── Multi-account ─────────────────────────────────────────────
# BRIDGE_ACCOUNTS_FILE=./accounts.json
# BRIDGE_AUTH_CACHE_DIR=./auth_cache

# ── Quota / citations ─────────────────────────────────────────
# BRIDGE_QUOTA_TTL=30              # seconds to cache /v1/quota
# BRIDGE_RESOLVE_CITATIONS=0       # 1 = resolve grounding citation redirects to the real URL
